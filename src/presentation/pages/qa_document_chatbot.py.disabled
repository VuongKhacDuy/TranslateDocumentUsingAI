# QA Document Chatbot with LangChain
# Yêu cầu: Đã cài langchain, openai, chromadb, tiktoken

import streamlit as st
from langchain_openai import OpenAIEmbeddings, ChatOpenAI
from langchain.text_splitter import CharacterTextSplitter
from langchain_community.vectorstores import Chroma
from langchain.chains import RetrievalQA
import os

st.header("📄 AI Chatbot hỏi đáp tài liệu")

uploaded_file = st.file_uploader("Tải lên tài liệu (txt)", type=["txt"])
question = st.text_input("Nhập câu hỏi về tài liệu:")

if uploaded_file and question:
    # Đọc nội dung file
    doc_text = uploaded_file.read().decode("utf-8")
    # Tách đoạn
    splitter = CharacterTextSplitter(chunk_size=1000, chunk_overlap=100)
    docs = splitter.split_text(doc_text)
    # Tạo vectorstore
    embeddings = OpenAIEmbeddings(openai_api_key=os.getenv("OPENAI_API_KEY"))
    vectordb = Chroma.from_texts(docs, embeddings)
    # Tạo chain QA
    llm = ChatOpenAI(openai_api_key=os.getenv("OPENAI_API_KEY"))
    qa_chain = RetrievalQA.from_chain_type(llm, retriever=vectordb.as_retriever())
    # Trả lời câu hỏi
    answer = qa_chain.run(question)
    st.success("Câu trả lời:")
    st.write(answer)
else:
    st.info("Vui lòng tải lên tài liệu và nhập câu hỏi.")
